# =============================================================================
# ANDRES SPORTSWEARTZ - ENVIRONMENT VARIABLES
# =============================================================================
# HOW TO USE THIS FILE
#   1. Make a copy of this file in the same folder.
#   2. Rename the copy to exactly:   .env.local
#      (the name must start with a dot and the file must have no .txt ending)
#   3. Fill in your real values after the = sign.
#   4. Restart the website after changing anything here.
#
# NEVER share .env.local and never upload it to GitHub.
# The project .gitignore file already blocks it automatically.
# =============================================================================


# -----------------------------------------------------------------------------
# PUBLIC BUSINESS DETAILS
# These are shown to visitors, so they are not secrets.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_BUSINESS_NAME=Andres Sportsweartz

# WhatsApp number in international format, DIGITS ONLY.
# Tanzania example: 255 then the number without the leading zero.
NEXT_PUBLIC_WHATSAPP_NUMBER=255700000000

NEXT_PUBLIC_PHONE_NUMBER=+255 700 000 000

NEXT_PUBLIC_CURRENCY=TZS

NEXT_PUBLIC_SITE_URL=https://andres-sportsweartz.vercel.app

NEXT_PUBLIC_BUSINESS_ADDRESS=Dar es Salaam, Tanzania

NEXT_PUBLIC_BUSINESS_HOURS=Monday to Saturday, 08:00 - 19:00

NEXT_PUBLIC_DELIVERY_INFORMATION=Delivery details are confirmed with you after we receive your order.

# Social media links. Leave empty if you do not have them yet.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=


# -----------------------------------------------------------------------------
# SUPABASE DATABASE (SECRET)
# Leave these two empty until your Supabase project is ready.
# The shop keeps working without them by using WhatsApp ordering.
#
# Where to find them:
#   SUPABASE_URL               -> Supabase, Project Settings, Data API, Project URL
#   SUPABASE_ANON_KEY          -> Supabase, Project Settings, API Keys, anon public
#   SUPABASE_SERVICE_ROLE_KEY  -> Supabase, Project Settings, API Keys, service_role
#
# WARNING: the service_role key can read and change EVERYTHING in your database.
# It must never be given the NEXT_PUBLIC_ prefix, never be shared, and never be
# committed to GitHub. Only the server uses it.
# -----------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=